{
  "name": "openchamber-live-tps",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "OpenChamber Work Status section: instant live TPS with sparkline, last-turn average, and TTFT.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwwzzzxxx/openchamber-live-tps.git"
  },
  "homepage": "https://github.com/wwwzzzxxx/openchamber-live-tps#readme",
  "bugs": {
    "url": "https://github.com/wwwzzzxxx/openchamber-live-tps/issues"
  },
  "keywords": [
    "openchamber",
    "extension",
    "tokens-per-second",
    "tps",
    "throughput",
    "latency",
    "status-panel"
  ],
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.4"
    },
    "contributes": {
      "panel": {
        "id": "live-tps",
        "name": "Live TPS",
        "icon": "speed-up-line",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "Live TPS",
        "height": 64
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      }
    }
  },
  "scripts": {
    "build": "bun run build:status && bun run build:panel && bun run build:service",
    "build:status": "bunx openchamber-guest-bundle status/main.ts status/main.js",
    "build:panel": "bunx openchamber-guest-bundle panel/main.ts panel/main.js",
    "build:service": "bunx openchamber-guest-bundle --node service/main.ts service/main.js",
    "test": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@openchamber/sdk": "2.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.3"
  }
}
