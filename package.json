{
  "name": "openchamber-live-tps",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "OpenChamber Work Status section: instant live TPS with sparkline, last-turn average, TTFT, and the day's provider-reported token usage.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwwzzzxxx/openchamber-live-tps.git"
  },
  "homepage": "https://github.com/wwwzzzxxx/openchamber-live-tps#readme",
  "bugs": {
    "url": "https://github.com/wwwzzzxxx/openchamber-live-tps/issues"
  },
  "keywords": [
    "openchamber",
    "extension",
    "tokens-per-second",
    "tps",
    "throughput",
    "latency",
    "status-panel",
    "tokens-per-day",
    "token-usage",
    "daily-tokens"
  ],
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "contributes": {
      "panel": {
        "id": "live-tps",
        "name": "TPS & Token",
        "icon": "pulse",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "TPS · Token",
        "height": 120
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "keepRunning": true
      },
      "sessionEvents": {
        "events": [
          "turn-started",
          "turn-finished",
          "turn-failed",
          "session-created"
        ]
      }
    }
  },
  "scripts": {
    "build": "bun run build:status && bun run build:panel && bun run build:service",
    "build:status": "bunx openchamber-guest-bundle status/main.ts status/main.js",
    "build:panel": "bunx openchamber-guest-bundle panel/main.ts panel/main.js",
    "build:service": "bunx openchamber-guest-bundle --node service/main.ts service/main.js",
    "test": "node scripts/smoke.mjs && node scripts/regressions.mjs && node scripts/page-smoke.mjs && node scripts/cache.mjs"
  },
  "dependencies": {
    "@openchamber/sdk": "2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3"
  }
}
